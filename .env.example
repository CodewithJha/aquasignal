# Copy to .env locally. Never commit real keys. See docs/CONFIGURATION.md.
# The app reads plain environment variables; it does not auto-load .env.
# Load it in your shell with:  set -a; source .env; set +a
# or with Docker:              docker run --env-file .env ...

# --- AI (optional, advisory only) -------------------------------------------
# Default is null: no network calls, no key needed. The full demo works this way.
# Values: null (default) | fake (deterministic, tests/offline demos) | openai
# "openai" means any OpenAI-compatible /chat/completions endpoint (set AI_BASE_URL).
# If AI_PROVIDER=openai but no key is set, the app falls back to null.
AI_PROVIDER=null
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_TIMEOUT=8
# Example: Featherless (OpenAI-compatible)
# AI_BASE_URL=https://api.featherless.ai/v1
# AI_MODEL=<model id from your provider>
# OPENAI_API_KEY is accepted as a fallback if AI_API_KEY is unset.

# --- Storage -----------------------------------------------------------------
# SQLite file. Default: <repo>/data/confirmgate.sqlite3 (relative to the repo).
# Docker image default: sqlite:////data/confirmgate.sqlite3 (mount a volume at /data).
# DATABASE_URL=sqlite:///data/confirmgate.sqlite3

# --- HTTP --------------------------------------------------------------------
# Largest request body in bytes (default 10 MB). Oversized uploads get HTTP 413.
# MAX_UPLOAD_BYTES=10485760

# Honored by the Docker image CMD. Locally, pass it to uvicorn:
#   uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
# PORT=8000
